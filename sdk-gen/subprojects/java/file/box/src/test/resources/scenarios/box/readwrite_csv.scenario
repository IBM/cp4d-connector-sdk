# ============================================================
# box — write + read back + discover a CSV
# ============================================================
# Verifies round-trip write and read within the isolated
# test work directory, then confirms discovery lists the file.
# ${work_dir} is injected at runtime by FileTestSuite.scenario().

[Step]
Type=Write
Interaction.file_name=/${work_dir}/readwrite_test.csv
Interaction.first_line_header=true
Schema=id|integer; label|varchar; flag|boolean
Row.0=1|Alice|true
Row.1=2|Bob|false
Row.2=3|<NULL>|true

[Step]
Type=Read
Interaction.file_name=/${work_dir}/readwrite_test.csv
ExpectedColumns=id|label|flag
ExpectedRowCount=3
ExpectedRows.0=1|Alice|true
ExpectedRows.1=2|Bob|false
ExpectedRows.2=3|<NULL>|true

[Step]
Type=Discover
Path=/${work_dir}/
ExpectedContains=readwrite_test.csv

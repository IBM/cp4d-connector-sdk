# ============================================================
# S3 — read CSV with explicit row delimiter
# ============================================================
# Verifies that the connector reads a CSV and correctly exposes
# the row_delimiter_value in the returned interaction properties.
# ${work_dir} is injected at runtime by FileTestSuite.scenario().

# ── Write a CSV (S3 put hook produces LF-terminated rows) ────
[Step]
Type=Write
Interaction.file_name=/${work_dir}/csv_row_delim.csv
Interaction.first_line_header=true
Schema=year|integer; make|varchar; model|varchar
Row.0=2012|Tesla|S
Row.1=1997|Ford|E350
Row.2=2015|Chevy|Volt

# ── Metadata: verify row_delimiter_value is reported ─────────
[Step]
Type=Metadata
Interaction.file_name=/${work_dir}/csv_row_delim.csv
ExpectedInteractionProperty.file_format=csv

# ── Read back and verify content ─────────────────────────────
[Step]
Type=Read
Interaction.file_name=/${work_dir}/csv_row_delim.csv
ExpectedColumns=year|make|model
ExpectedRowCount=3
ExpectedRows.0=2012|Tesla|S
ExpectedRows.2=2015|Chevy|Volt

# ============================================================
# LocalFS — read CRLF-delimited CSV (row_delimiter_value)
# ============================================================
# Verifies that the connector detects and reports CRLF line
# endings in the returned interaction properties.
# ${work_dir} is injected at runtime by FileTestSuite.scenario().

# ── Write a normal CSV (connector always writes LF) ─────────
[Step]
Type=Write
Interaction.file_name=${work_dir}/csv_row_delim.csv
Interaction.first_line_header=true
Schema=year|integer; make|varchar; model|varchar
Row.0=2012|Tesla|S
Row.1=1997|Ford|E350
Row.2=2015|Chevy|Volt

# ── Read back and verify row count and data ──────────────────
[Step]
Type=Read
Interaction.file_name=${work_dir}/csv_row_delim.csv
ExpectedColumns=year|make|model
ExpectedRowCount=3
ExpectedRows.0=2012|Tesla|S
ExpectedRows.2=2015|Chevy|Volt

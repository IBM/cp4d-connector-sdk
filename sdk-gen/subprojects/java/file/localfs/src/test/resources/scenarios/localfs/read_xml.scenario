# ============================================================
# LocalFS — write + read XML (3 rows, typed values)
# ============================================================
# Writes a typed XML file and reads it back, verifying row
# count and spot-check values.
# XML columns are returned in alphabetical order (like JSON).
# ${work_dir} is injected at runtime by FileTestSuite.scenario().

# ── Write an XML file ────────────────────────────────────────
[Step]
Type=Write
Interaction.file_name=${work_dir}/readwrite.xml
Interaction.file_format=xml
Schema=id|integer; label|varchar; flag|boolean
Row.0=1|Alice|true
Row.1=2|Bob|false
Row.2=3|<NULL>|true

# ── Read back and verify content ─────────────────────────────
[Step]
Type=Read
Interaction.file_name=${work_dir}/readwrite.xml
ExpectedRowCount=3
# XML columns returned alphabetically: flag, id, label
ExpectedCell.0.1=1
ExpectedCell.1.1=2
ExpectedCell.2.1=3
ExpectedCell.2.2=<NULL>

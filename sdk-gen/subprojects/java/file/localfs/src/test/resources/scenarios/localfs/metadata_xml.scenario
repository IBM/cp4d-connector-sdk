# ============================================================
# LocalFS — getFlightInfo metadata assertions for an XML file
# ============================================================
# Writes a known XML file, then verifies the returned descriptor
# carries the correct file_format and mime_type.
# ${work_dir} is injected at runtime by FileTestSuite.scenario().

# ── Write an XML file ────────────────────────────────────────
[Step]
Type=Write
Interaction.file_name=${work_dir}/meta_xml.xml
Interaction.file_format=xml
Schema=id|integer; label|varchar
Row.0=1|hello

# ── Check returned interaction properties ───────────────────
[Step]
Type=Metadata
Interaction.file_name=${work_dir}/meta_xml.xml
ExpectedInteractionProperty.file_format=xml
ExpectedDetail.mime_type=application/xml
ExpectedSchemaFields=id|label

# ============================================================
# LocalFS — write, read, metadata and discover checks for JSON
# ============================================================
# Writes a typed JSON file (3 rows), reads it back verifying row count and
# spot-check values, then checks the detected file_format, mime_type and
# columns (JSON columns are returned alphabetically), then confirms the file
# appears in a discovery listing of the work directory.
# ${work_dir} is injected at runtime by FileTestSuite.scenario().

# ── Write a JSON file ──────────────────────────────────────────
[Step]
Type=Write
Interaction.file_name=${work_dir}/readwrite.json
Interaction.file_format=json
Schema=id|integer; label|varchar; flag|boolean
Row.0=1|Alice|true
Row.1=2|Bob|false
Row.2=3|<NULL>|true

# ── Read back and verify content ─────────────────────────────
[Step]
Type=Read
Interaction.file_name=${work_dir}/readwrite.json
ExpectedRowCount=3
# JSON columns are returned alphabetically: flag, id, label
ExpectedCell.0.1=1
ExpectedCell.1.1=2
ExpectedCell.2.1=3
ExpectedCell.2.2=<NULL>

# ── Check returned interaction properties ───────────────────
[Step]
Type=Metadata
Interaction.file_name=${work_dir}/readwrite.json
ExpectedInteractionProperty.file_format=json
ExpectedDetail.mime_type=application/json
ExpectedSchemaFields=flag|id|label

# ── Discover: file must appear in the work-dir listing ──────
[Step]
Type=Discover
Path=${work_dir}
ExpectedContains=readwrite.json

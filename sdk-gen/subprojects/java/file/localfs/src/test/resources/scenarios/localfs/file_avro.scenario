# ============================================================
# LocalFS — write, read and metadata checks for Avro
# ============================================================
# Writes a typed Avro file (3 rows), reads it back verifying row
# count, typed values and nulls, checks row_limit and byte_limit,
# then verifies the detected file_format, mime_type and columns.
# ${work_dir} is injected at runtime by FileTestSuite.scenario().

# ── Write a Avro file ──────────────────────────────────────────
[Step]
Type=Write
Interaction.file_name=${work_dir}/readwrite.avro
Interaction.file_format=avro
Schema=id|integer; label|varchar; flag|boolean
Row.0=1|Alice|true
Row.1=2|Bob|false
Row.2=3|<NULL>|true

# ── Read back and verify content ─────────────────────────────
[Step]
Type=Read
Interaction.file_name=${work_dir}/readwrite.avro
ExpectedRowCount=3
ExpectedCell.0.0=1
ExpectedCell.0.1=Alice
ExpectedCell.1.0=2
ExpectedCell.1.1=Bob
ExpectedCell.2.0=3
ExpectedCell.2.1=<NULL>

# ── row_limit must cap the result ────────────────────────────
[Step]
Type=Read
Interaction.file_name=${work_dir}/readwrite.avro
Interaction.row_limit=1
ExpectedRowCount=1
ExpectedCell.0.0=1

# ── byte_limit must return fewer than 3 rows ─────────────────
[Step]
Type=Read
Interaction.file_name=${work_dir}/readwrite.avro
Interaction.byte_limit=1

# ── Check returned interaction properties ───────────────────
[Step]
Type=Metadata
Interaction.file_name=${work_dir}/readwrite.avro
ExpectedInteractionProperty.file_format=avro
ExpectedDetail.mime_type=application/octet-stream
ExpectedSchemaFields=id|label|flag

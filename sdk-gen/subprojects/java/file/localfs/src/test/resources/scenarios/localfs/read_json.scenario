# ============================================================
# LocalFS — write + read JSON
# ============================================================
# Writes a typed JSON file and reads it back, verifying row
# count and a spot-check cell value.
# JSON columns are returned in alphabetical order.
# ${work_dir} is injected at runtime by FileTestSuite.scenario().

# ── Write a JSON file ────────────────────────────────────────
[Step]
Type=Write
Interaction.file_name=${work_dir}/readwrite_json.json
Interaction.file_format=json
Schema=id|integer; label|varchar; flag|boolean
Row.0=1|Alice|true
Row.1=2|Bob|false
Row.2=3|<NULL>|true

# ── Read back and verify content ─────────────────────────────
[Step]
Type=Read
Interaction.file_name=${work_dir}/readwrite_json.json
ExpectedRowCount=3
# JSON returns columns in alphabetical order: flag, id, label
ExpectedCell.0.1=1
ExpectedCell.1.1=2
ExpectedCell.2.1=3

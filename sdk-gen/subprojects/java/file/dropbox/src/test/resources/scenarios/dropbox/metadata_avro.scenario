# ============================================================
# dropbox — getFlightInfo metadata assertions for a AVRO file
# ============================================================
# Writes a known AVRO file, then verifies the returned descriptor
# carries the correct file_format and mime_type.
# ${work_dir} is injected at runtime by FileTestSuite.scenario().

# ── Write a AVRO file ──────────────────────────────────────
[Step]
Type=Write
Interaction.file_name=/${work_dir}/meta_avro.avro
Interaction.file_format=avro
Schema=id|integer; label|varchar
Row.0=1|hello

# ── Check returned interaction properties ───────────────────
[Step]
Type=Metadata
Interaction.file_name=/${work_dir}/meta_avro.avro
ExpectedInteractionProperty.file_format=avro
ExpectedDetail.mime_type=application/octet-stream
ExpectedSchemaFields=id|label

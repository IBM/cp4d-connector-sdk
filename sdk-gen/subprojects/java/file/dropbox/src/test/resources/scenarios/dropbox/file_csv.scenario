# ============================================================
# dropbox — write, read, metadata and discover checks for CSV
# ============================================================
# Writes a typed CSV (3 rows), reads it back verifying columns, values and nulls,
# checks the detected interaction properties and mime type, then confirms the
# file appears in a discovery listing of the work directory.
# ${work_dir} is injected at runtime by FileTestSuite.scenario().

# ── Write a CSV file ──────────────────────────────────────────
[Step]
Type=Write
Interaction.file_name=/${work_dir}/readwrite.csv
Interaction.first_line_header=true
Schema=id|integer; label|varchar; flag|boolean
Row.0=1|Alice|true
Row.1=2|Bob|false
Row.2=3|<NULL>|true

# ── Read back and verify content ─────────────────────────────
[Step]
Type=Read
Interaction.file_name=/${work_dir}/readwrite.csv
ExpectedColumns=id|label|flag
ExpectedRowCount=3
ExpectedRows.0=1|Alice|true
ExpectedRows.1=2|Bob|false
ExpectedRows.2=3|<NULL>|true

# ── Check returned interaction properties ───────────────────
[Step]
Type=Metadata
Interaction.file_name=/${work_dir}/readwrite.csv
ExpectedInteractionProperty.file_name=/${work_dir}/readwrite.csv
ExpectedInteractionProperty.file_format=csv
ExpectedInteractionProperty.first_line_header=true
ExpectedDetail.mime_type=text/csv
ExpectedSchemaFields=id|label|flag

# ── Discover: file must appear in the work-dir listing ──────
[Step]
Type=Discover
Path=/${work_dir}/
ExpectedContains=readwrite.csv

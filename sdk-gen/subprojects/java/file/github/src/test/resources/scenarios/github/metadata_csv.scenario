# ============================================================
# GitHub — getFlightInfo for cars.csv (metadata + schema)
# ============================================================
# Mode A: reads a stable well-known test file that has been in
# apache/spark since Spark 1.x. The schema and field_delimiter
# are part of the connector's parsing contract and are
# unlikely to change even if the file content changes.

[Step]
Type=Metadata
Interaction.branch_name=master
Interaction.file_name=sql/core/src/test/resources/test-data/cars.csv
ExpectedInteractionProperty.branch_name=master
ExpectedInteractionProperty.file_name=sql/core/src/test/resources/test-data/cars.csv
ExpectedInteractionProperty.file_format=csv
ExpectedInteractionProperty.first_line_header=true
ExpectedInteractionProperty.field_delimiter_value=,
ExpectedInteractionProperty.row_delimiter_value=\n
ExpectedDetail.mime_type=text/csv
ExpectedSchemaFields=year|make|model|comment|blank

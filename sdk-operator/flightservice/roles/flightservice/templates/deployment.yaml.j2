kind: Deployment
apiVersion: apps/v1
metadata:
  name: '{{ ansible_operator_meta.name }}-flightservice'
  namespace: '{{ ansible_operator_meta.namespace }}'
  labels:
    app: '{{ ansible_operator_meta.name }}-flightservice'
spec:
  replicas: {{ replicas | int }}
  selector:
    matchLabels:
      app: '{{ ansible_operator_meta.name }}-flightservice'
  template:
    metadata:
      labels:
        app: '{{ ansible_operator_meta.name }}-flightservice'
    spec:
      containers:
      - name: '{{ ansible_operator_meta.name }}-flightservice'
        image: {{ docker_image | to_json }}
        ports:
        - containerPort: 9443
          protocol: TCP
        resources:
          limits:
            cpu: {{ resources.cpu.limits | string | to_json }}
            memory: {{ resources.memory.limits | string | to_json }}
          requests:
            cpu: {{ resources.cpu.requests | string | to_json }}
            memory: {{ resources.memory.requests | string | to_json }}
